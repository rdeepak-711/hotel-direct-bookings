# Direct Booking Check: environment variables. Copy to .env and fill in. Keys are read only on the server.

# Google Cloud key with BOTH "Places API (New)" and "PageSpeed Insights API" enabled, restricted to those two.
# Set a hard daily quota on this key in Google Cloud: it is the real spending guard.
GOOGLE_PLACES_API_KEY=
# Same key as above (both APIs on one key). Required in live mode: without it PageSpeed throttles silently.
PAGESPEED_API_KEY=
# Tripadvisor Content API (Terra). Optional in v1.
TRIPADVISOR_API_KEY=
# A secret you invent (openssl rand -hex 16). ?partner=<this> on a report URL shows Hotelzify product names. Empty = partner view off.
PARTNER_TOKEN=
# OpenRouter key for the one AI call per report. A viewer may send their own key instead; it is used once and never stored.
OPENROUTER_API_KEY=
# Model OpenRouter runs. Free model for demos; free models cap at 50 requests a day.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Which AI client: "openrouter" makes real calls, "fake" returns scripted answers (tests, previews), "claude-cli" uses your local `claude -p` (your Mac only, never Vercel; DEC-6).
LLM_MODE=openrouter
# Which data: "live" calls Google and the others, "fixture" reads tests/fixtures/*.json (tests, previews, demos).
SOURCES_MODE=live
# Reports one visitor IP may run per hour before a 429. Best effort on serverless; the Google quota is the hard cap.
REPORTS_PER_VISITOR_PER_HOUR=10
